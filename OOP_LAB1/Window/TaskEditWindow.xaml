<Window x:Class="OOP_LAB1.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи" Height="400" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Название -->
            <RowDefinition Height="Auto"/>
            <!-- Категория -->
            <RowDefinition Height="*"/>
            <!-- Описание (заполняет пространство) -->
            <RowDefinition Height="Auto"/>
            <!-- Снизу: галочка -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <Label Content="Название:" />
        <TextBox x:Name="TitleTextBox" Grid.Row="0" Margin="0 5 0 10"/>

        <Label Content="Категория:" Grid.Row="1" />
        <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Margin="80 5 0 10" HorizontalAlignment="Left" Width="150"/>

        <TextBox x:Name="DescriptionTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0 0 0 10"/>

        <CheckBox x:Name="HighPriorityCheckBox" Content="Высокий приоритет" Grid.Row="3" HorizontalAlignment="Left" Margin="0 0 0 10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="75" Margin="0 0 10 0" Click="Save_Click"/>
            <Button Content="Отмена" Width="75" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
