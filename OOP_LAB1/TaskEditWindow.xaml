<Window x:Class="OOP_LAB1.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи" Height="440" Width="428" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Название -->
            <RowDefinition Height="Auto"/>
            <!-- Категория -->
            <RowDefinition Height="*"/>
            <!-- Описание (занимает всё свободное пространство) -->
            <RowDefinition Height="Auto"/>
            <!-- Дата и время выполнения -->
            <RowDefinition Height="Auto"/>
            <!-- Высокий приоритет и кнопки -->
        </Grid.RowDefinitions>

        <!-- Название -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 8">
            <Label Content="Название:" Width="75"/>
            <TextBox x:Name="TitleTextBox" Width="280" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 8">
            <Label Content="Категория:" Width="75"/>
            <ComboBox x:Name="CategoryComboBox" Width="150" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Описание -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0 0 0 8">
            <Label Content="Описание:"/>
            <TextBox x:Name="DescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100"/>
        </StackPanel>

        <!-- Дата и время выполнения -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 8">
            <Label Content="Выполнить до:" Width="100"/>
            <DatePicker x:Name="DueDatePicker" Width="120" Margin="10,0,0,0"/>
            <Label Content="время (HH:mm):" Width="95" Margin="18,0,0,0"/>
            <TextBox x:Name="DueTimeTextBox" Width="50" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Нижний ряд: приоритет + кнопки -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="HighPriorityCheckBox"
                      Content="Высокий приоритет"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="75" Margin="0 0 10 0" Click="Save_Click"/>
                <Button Content="Отмена" Width="75" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
